# Modèle de configuration de l'API autonome.
#
# Dans la Plateforme Complète, l'API lit le fichier .env à la RACINE de la
# plateforme (écrit par scripts/installer.php). Ce modèle sert uniquement
# si l'API est utilisée seule, hors de la plateforme.
#
# Valeurs fictives de démonstration : à remplacer par vos propres identifiants.
# N'utilisez jamais le compte root de MySQL pour l'application.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stages_final
DB_USER=stages_app
DB_PASS=StagesApp123!
DB_CHARSET=utf8mb4
