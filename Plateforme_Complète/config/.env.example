# Configuration de la base de données — modèle à copier en .env (racine du dossier).
# Les valeurs ci-dessous correspondent à un compte FICTIF de démonstration :
# à remplacer par vos propres identifiants avant un vrai déploiement.
# Ce compte n'est jamais le compte root/administrateur MySQL.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stages_final
DB_USER=stages_app
DB_PASS=StagesApp123!
DB_CHARSET=utf8mb4
