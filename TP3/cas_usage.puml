@startuml cas_usage
left to right direction
skinparam shadowing false
actor "Étudiant" as E
actor "Responsable" as R
actor "Administrateur" as A

rectangle "Système de gestion des stages" {
  usecase "Soumettre une demande (EF-02)" as UC1
  usecase "Consulter l'état (EF-06)" as UC2
  usecase "Examiner un dossier" as UC3
  usecase "Valider ou refuser (EF-03)" as UC4
  usecase "Programmer une soutenance (EF-05)" as UC5
  usecase "Gérer les comptes" as UC6
  usecase "Se connecter (EF-01)" as UC0
}

E --> UC1
E --> UC2
R --> UC3
R --> UC4
R --> UC5
A --> UC6

UC1 .> UC0 : include
UC2 .> UC0 : include
UC3 .> UC0 : include
UC4 .> UC0 : include
UC5 .> UC0 : include
UC6 .> UC0 : include
@enduml
